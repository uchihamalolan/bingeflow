{
  "name": "bingeflow",
  "version": "0.0.5",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "wxt prepare",
    "test": "vitest run",
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox --mv3",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "zip:all": "wxt zip & wxt zip -b firefox --mv3",
    "lint": "oxlint -c ~/.config/oxc/oxlint.json",
    "fmt": "oxfmt -c ~/.config/oxc/oxfmt.json"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "defu": "^6.1.7",
    "solid-js": "^1.9.3"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.2",
    "happy-dom": "^20.11.1",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "~5.9.3",
    "unocss": "^66.7.5",
    "vite-plugin-solid": "^2.11.0",
    "vitest": "^4.1.10",
    "wxt": "^0.20.26"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.18.0",
      "onFail": "error"
    }
  }
}
